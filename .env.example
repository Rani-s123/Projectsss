# Required — Anthropic API key (https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxx

# Optional — Nutrient DWS. Parses uploaded PDFs/scans and digitally signs the
# released audit record. Free credits on signup: https://nutrient.io
NUTRIENT_API_KEY=

# Optional — Doctavian. Generates the compliant output document from cleared
# data, branching on tax treatment / expiry / jurisdiction. https://doctavian.com
DOCTAVIAN_API_KEY=
